<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AthkarApp.Models"
             x:Class="AthkarApp.Views.SharedKhatmahDetailsPage"
             Title="تفاصيل الختمة"
             FlowDirection="RightToLeft">

    <ContentPage.Resources>
        <ResourceDictionary>
            <models:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <models:BoolToColorConverter x:Key="BoolToColorConverter" />
            <models:AvailableToBgConverter x:Key="AvailableToBgConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">
        
        <!-- Khatmah Info Header -->
        <Border Grid.Row="0" Margin="15" Padding="15" StrokeShape="RoundRectangle 10" BackgroundColor="#143214">
            <VerticalStackLayout Spacing="5">
                <Label x:Name="NameLabel" FontSize="20" FontAttributes="Bold" TextColor="#D4AF37" HorizontalTextAlignment="Center"/>
                <Label x:Name="IntentionLabel" FontSize="16" TextColor="White" HorizontalTextAlignment="Center"/>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,10,0,0">
                    <Label Text="كود المشاركة:" TextColor="White" VerticalOptions="Center"/>
                    <Label x:Name="CodeLabel" FontSize="18" FontAttributes="Bold" TextColor="#D4AF37" VerticalOptions="Center"/>
                    <ImageButton Source="share_icon.png" WidthRequest="24" HeightRequest="24" Clicked="OnShareCodeClicked" BackgroundColor="Transparent" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Overall Progress -->
        <VerticalStackLayout Grid.Row="1" Margin="20,0,20,15" Spacing="5">
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="نسبة الإنجاز" FontAttributes="Bold" HorizontalOptions="Start" />
                <Label Grid.Column="1" x:Name="ProgressTextLabel" FontAttributes="Bold" TextColor="#D4AF37" HorizontalOptions="End" />
            </Grid>
            <ProgressBar x:Name="OverallProgressBar" ProgressColor="#D4AF37" HeightRequest="10" />
        </VerticalStackLayout>

        <!-- Parts List (30 Ajzaa) -->
        <CollectionView Grid.Row="2" x:Name="PartsCollectionView" Margin="10,0,10,10">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:KhatmahPart">
                    <Border StrokeShape="RoundRectangle 10" 
                            Stroke="{Binding IsCompleted, Converter={StaticResource BoolToColorConverter}}" 
                            StrokeThickness="2"
                            BackgroundColor="{Binding IsAvailable, Converter={StaticResource AvailableToBgConverter}}"
                            Padding="10">
                        
                        <Grid RowDefinitions="Auto, *, Auto">
                            <Label Grid.Row="0" Text="{Binding PartNumber, StringFormat='الجزء {0}'}" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   HorizontalTextAlignment="Center" />
                                   
                            <Label Grid.Row="1" 
                                   Text="{Binding TakenBy}" 
                                   IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBoolConverter}}"
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation"
                                   TextColor="Gray" />
                                   
                            <Label Grid.Row="1" 
                                   Text="متاح للحجز" 
                                   IsVisible="{Binding IsAvailable}"
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalOptions="Center"
                                   TextColor="#88BB88" />

                            <Label Grid.Row="2"
                                   Text="✅ مكتمل"
                                   IsVisible="{Binding IsCompleted}"
                                   TextColor="Green"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,5,0,0"/>

                            <Button Grid.Row="2"
                                    Text="حجز الجزء"
                                    IsVisible="{Binding IsAvailable}"
                                    BackgroundColor="#143214"
                                    TextColor="White"
                                    HeightRequest="35"
                                    Padding="0"
                                    CornerRadius="5"
                                    Margin="0,5,0,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=TakePartCommand}"
                                    CommandParameter="{Binding .}" />
                                    
                            <Button Grid.Row="2"
                                    Text="تفاصيل / إتمام"
                                    IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="#D4AF37"
                                    TextColor="#143214"
                                    HeightRequest="35"
                                    Padding="0"
                                    CornerRadius="5"
                                    Margin="0,5,0,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=PartDetailsCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
