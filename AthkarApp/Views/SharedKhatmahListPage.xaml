<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AthkarApp.Models"
             x:Class="AthkarApp.Views.SharedKhatmahListPage"
             Title="الختمات المشتركة"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Header Actions -->
        <HorizontalStackLayout Grid.Row="0" Spacing="15" Padding="20" HorizontalOptions="Center">
            <Button Text="إنشاء ختمة جديدة ➕" 
                    Clicked="OnCreateKhatmahClicked"
                    BackgroundColor="#143214"
                    TextColor="#D4AF37"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    Padding="20,10"/>
                    
            <Button Text="الانضمام بكود 🔗" 
                    Clicked="OnJoinKhatmahClicked"
                    BackgroundColor="#D4AF37"
                    TextColor="#143214"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    Padding="20,10"/>
        </HorizontalStackLayout>

        <!-- List of Active Khatmahs -->
        <RefreshView Grid.Row="1" x:Name="KhatmahRefreshView" Refreshing="OnRefreshKhatmahs">
            <CollectionView x:Name="KhatmahsCollectionView" 
                            SelectionMode="Single"
                            SelectionChanged="OnKhatmahSelected"
                            EmptyView="لا توجد ختمات مشتركة حالياً. قم بإنشاء ختمة أو الانضمام لختمة موجودة.">
                
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                </CollectionView.ItemsLayout>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SharedKhatmah">
                        <Border StrokeShape="RoundRectangle 15" 
                                Stroke="#E0E0E0" 
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="15"
                                Margin="20,0,20,0">
                            
                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                                <!-- Name and Intention -->
                                <Label Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding Name}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="#143214" />
                                       
                                <Label Grid.Row="1" Grid.Column="0" 
                                       Text="{Binding Intention}" 
                                       FontSize="14" 
                                       TextColor="Gray" 
                                       Margin="0,5,0,0"/>

                                <!-- Progress text -->
                                <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                       Text="{Binding ProgressText}" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="#D4AF37"
                                       VerticalOptions="Center" />

                                <!-- Progress Bar -->
                                <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                             Progress="{Binding ProgressPercentage}" 
                                             ProgressColor="#D4AF37" 
                                             Margin="0,15,0,0" 
                                             HeightRequest="8"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
